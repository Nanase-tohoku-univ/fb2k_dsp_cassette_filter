  <!-- Post-build: package .dll into .fb2k-component (ZIP archive) -->
  <Target Name="PostBuildPackage" AfterTargets="Link">
    <Delete Files="$(OutDir)$(TargetName).fb2k-component" Condition="Exists('$(OutDir)$(TargetName).fb2k-component')" />
    <Delete Files="$(OutDir)$(TargetName).zip" Condition="Exists('$(OutDir)$(TargetName).zip')" />
    <Exec Command="powershell -NoProfile -Command &quot;Compress-Archive -LiteralPath '$(OutDir)$(TargetName).dll' -DestinationPath '$(OutDir)$(TargetName).zip'; Rename-Item -LiteralPath '$(OutDir)$(TargetName).zip' -NewName '$(TargetName).fb2k-component'&quot;" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="packages\wtl.10.1.0\build\native\wtl.targets" Condition="Exists('packages\wtl.10.1.0\build\native\wtl.targets')" />
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
